{
  "comments": {
    "lineComment": "//",
    "blockComment": [
      "/*",
      "*/"
    ]
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "wordPattern": "@@?[A-Za-z_][A-Za-z0-9_-]*|:[A-Za-z_][A-Za-z0-9_-]*|[A-Za-z_][A-Za-z0-9_]*",
  "folding": {
    "markers": {
      "start": "^\\s*(?:module\\b|begin\\b|case\\b|do\\b|for\\b|if\\b|loop\\b|while\\b|atomic\\b|debug\\b)",
      "end": "^\\s*end\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:.*\\b(?:begin|case|do|else|elsif|for|if|loop|module|when|while|atomic|debug)\\b.*|.*\\b(?:then|do)\\s*(?://.*)?$)",
    "decreaseIndentPattern": "^\\s*(?:end|else|elsif|when|while)\\b"
  }
}