{
  "name": "Mindcode",
  "scopeName": "source.mindcode",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#function-definitions"
    },
    {
      "include": "#formattable-strings"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#characters"
    },
    {
      "include": "#color-literals"
    },
    {
      "include": "#number-literals"
    },
    {
      "include": "#boolean-and-null"
    },
    {
      "include": "#special-identifiers"
    },
    {
      "include": "#storage"
    },
    {
      "include": "#control-keywords"
    },
    {
      "include": "#operator-keywords"
    },
    {
      "include": "#reserved-keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#builtin-functions"
    },
    {
      "include": "#function-calls"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.mindcode",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.mindcode",
          "match": "//.*$"
        },
        {
          "name": "comment.block.mindcode",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.mindcode",
          "match": "#(?:setlocal|set|declare)\\b"
        }
      ]
    },
    "function-definitions": {
      "patterns": [
        {
          "name": "meta.function.definition.mindcode",
          "match": "\\b(?:debug\\s+)?(?:(?:inline|noinline|export|atomic)\\s+)*(?:def|void)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.mindcode"
            }
          }
        }
      ]
    },
    "formattable-strings": {
      "name": "string.quoted.double.interpolated.mindcode",
      "begin": "\\$\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.mindcode"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.mindcode"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.mindcode",
          "match": "\\\\(?:\\\\|\\$|n)"
        },
        {
          "name": "meta.interpolation.expression.mindcode",
          "begin": "\\$\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.mindcode"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.mindcode"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "name": "variable.other.interpolation.mindcode",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.mindcode",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.mindcode"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.mindcode"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.mindcode",
          "match": "\\\\n"
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "constant.character.mindcode",
          "match": "'(?:\\\\['\"]|[^'\\\\])'"
        }
      ]
    },
    "color-literals": {
      "patterns": [
        {
          "name": "constant.other.color.named.mindcode",
          "match": "%\\[[A-Za-z-]+\\]"
        },
        {
          "name": "constant.other.color.hex.mindcode",
          "match": "%[A-Fa-f0-9]{6}(?:[A-Fa-f0-9]{2})?\\b"
        }
      ]
    },
    "number-literals": {
      "patterns": [
        {
          "name": "constant.numeric.binary.mindcode",
          "match": "(?<![A-Za-z0-9_])-?0b[01]+\\b"
        },
        {
          "name": "constant.numeric.hex.mindcode",
          "match": "(?<![A-Za-z0-9_])-?0x[0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.decimal.mindcode",
          "match": "(?<![A-Za-z0-9_])(?:-?(?:\\d+\\.\\d*|\\d*\\.\\d+|\\d+)(?:[eE][+-]?\\d+)?)\\b"
        }
      ]
    },
    "boolean-and-null": {
      "patterns": [
        {
          "name": "constant.language.mindcode",
          "match": "\\b(?:true|false|null)\\b"
        }
      ]
    },
    "special-identifiers": {
      "patterns": [
        {
          "name": "support.constant.double-at.mindcode",
          "match": "@@[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "support.constant.builtin.mindcode",
          "match": "@[A-Za-z_][A-Za-z0-9_-]*"
        },
        {
          "name": "support.type.mlog-keyword.mindcode",
          "match": ":[A-Za-z_][A-Za-z0-9_-]*"
        }
      ]
    },
    "storage": {
      "patterns": [
        {
          "name": "storage.modifier.mindcode",
          "match": "\\b(?:atomic|cached|debug|export|guarded|inline|linked|mlog|noinit|noinline|out|private|public|ref|remote|volatile)\\b"
        },
        {
          "name": "storage.type.mindcode",
          "match": "\\b(?:allocate|const|def|external|heap|module|param|require|stack|var|void)\\b"
        }
      ]
    },
    "control-keywords": {
      "patterns": [
        {
          "name": "keyword.control.mindcode",
          "match": "\\b(?:begin|break|case|continue|descending|do|else|elsif|end|for|if|loop|return|then|when|while)\\b"
        }
      ]
    },
    "operator-keywords": {
      "patterns": [
        {
          "name": "keyword.operator.word.mindcode",
          "match": "\\b(?:and|in|not|or)\\b"
        }
      ]
    },
    "reserved-keywords": {
      "patterns": [
        {
          "name": "invalid.deprecated.mindcode",
          "match": "\\b(?:elif|elseif)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.mindcode",
          "match": "\\+\\+|--|>>>=|>>>|>>=|<<=|\\*\\*=|&&=|\\|\\|=|===|!==|%%=|%%|\\.\\.\\.|\\.\\.|==|!=|<=|>=|&&|\\|\\||<<|>>|[+\\-*/%&^|~!=<>?:=]"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.method.mindcode",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.call.mindcode",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.mindcode"
            }
          }
        }
      ]
    },
    "builtin-functions": {
      "patterns": [
        {
          "include": "#builtin-formatting-functions"
        },
        {
          "include": "#builtin-logic-functions"
        },
        {
          "include": "#builtin-unit-functions"
        },
        {
          "include": "#builtin-world-functions"
        }
      ]
    },
    "builtin-formatting-functions": {
      "patterns": [
        {
          "name": "support.function.builtin.mindcode",
          "match": "\\b(?:ascii|char|encode|format|localeprint|print|printchar|printf|printflush|println|remark|strlen)\\b(?=\\s*\\()"
        }
      ]
    },
    "builtin-logic-functions": {
      "patterns": [
        {
          "name": "support.function.builtin.mindcode",
          "match": "\\b(?:abs|acos|angle|angleDiff|asin|atan|atan2|ceil|clear|color|col|configure|config|control|cos|display|drawPrint|drawflush|effect|end|finished|floor|getBlock|getblock|getflag|getlink|idiv|image|len|length|line|linePoly|lineRect|log|log10|lookup|max|min|noise|packcolor|poly|pow|radar|rand|read|rect|reset|rotate|round|scale|sensor|setflag|setprop|sin|sqrt|stop|stopProcessor|stroke|sync|tan|translate|triangle|unpackcolor|wait|within|write)\\b(?=\\s*\\()"
        }
      ]
    },
    "builtin-unit-functions": {
      "patterns": [
        {
          "name": "support.function.builtin.mindcode",
          "match": "\\b(?:approach|autoPathfind|boost|build|deconstruct|flag|idle|itemDrop|itemTake|mine|move|pathfind|payDrop|payEnter|payTake|target|targetp|ubind|ucontrol|ulocate|unbind|uradar)\\b(?=\\s*\\()"
        }
      ]
    },
    "builtin-world-functions": {
      "patterns": [
        {
          "name": "support.function.builtin.mindcode",
          "match": "\\b(?:applyStatus|await|bullet|clearStatus|cutscene|explosion|fetch|getflag|makemarker|message|playsound|query|setblock|setmarker|setrate|setrule|spawn|spawnwave|weathersense|weatherset)\\b(?=\\s*\\()"
        }
      ]
    }
  }
}